# ── Firebase web app (Firebase console → Project settings → Your apps) ──
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# ── Server-only (Vercel / hosting env; never exposed to the browser) ──
GEMINI_API_KEY=
# Used by /api/ai/generate to verify the caller's Firebase ID token. Same value as VITE_FIREBASE_API_KEY.
FIREBASE_API_KEY=

# ── Email verification mode ──
# false (default): Firebase sends a verification LINK. true: users get a 6-digit one-time CODE from the Cloud Functions in /functions
# (needs the Blaze plan + SMTP secrets, see FIREBASE_SETUP.md §7).
VITE_EMAIL_OTP=false
