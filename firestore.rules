rules_version = '2';

// Cortex — production Firestore rules.
//
// Principles
//  * Deny by default. Every collection below is opted in explicitly.
//  * Users can only write their own data; cross-user writes (notifications, friend docs, counters) are allowed only
//    through narrow, verifiable shapes.
//  * Credits can't be typed into the console: balance changes must be paired, in the SAME batch, with a state
//    change on an escrow document (SOS request / tutor session). See src/services/credits.ts for the model.
//  * Admin authority = existence of /admins/{uid}. It can only be created by an existing admin, or by a user whose
//    VERIFIED email is on the /admin_emails allow-list. Bootstrap the first admin from the Firebase console.
//
// ⚠ Rules are validated by the emulator, not by this file's author. Run `firebase emulators:start` and exercise every
//   flow (see README "Deploying") before shipping.

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── helpers ─────────────────────────
    // "signedIn" means signed in AND the mailbox is verified (Google accounts always are; password accounts after the
    // link / one-time code). Unverified accounts may only perform the sign-up writes that use authed()/isSelf().
    function authed() { return request.auth != null; }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isSelf(uid) { return authed() && request.auth.uid == uid; }

    // Throw-away mailbox providers (keep in sync with src/lib/email-policy.ts).
    function notDisposable() {
      return !request.auth.token.get('email', '').lower().matches(
        '.*@(mailinator\\.com|guerrillamail\\.(com|net)|sharklasers\\.com|10minutemail\\.com|tempmail\\.com|temp-mail\\.org|yopmail\\.com|trashmail\\.com|getnada\\.com|dispostable\\.com|maildrop\\.cc|throwawaymail\\.com|fakeinbox\\.com|mintemail\\.com|emailondeck\\.com|mohmal\\.com|moakt\\.com|burnermail\\.io|tempr\\.email)');
    }
    function reservedHandle(h) {
      return h in ['admin', 'administrator', 'root', 'system', 'support', 'help', 'cortex', 'cortexai', 'official', 'staff',
                   'moderator', 'mod', 'owner', 'team', 'security', 'contact', 'info', 'noreply', 'null', 'undefined',
                   'api', 'www', 'about', 'settings', 'profile', 'login', 'logout', 'signup', 'register', 'auth',
                   'dashboard', 'community', 'tutors', 'groups', 'messages', 'notifications', 'leaderboard', 'sos',
                   'verify', 'privacy', 'terms', 'anonymous', 'everyone', 'me', 'you'];
    }
    function validUrl(v) { return v == null || (v is string && v.size() <= 600 && v.matches('^https://.*')); }
    function profileSane(d) {
      return (!('displayName' in d) || d.displayName == null || str(d.displayName, 80))
        && (!('about' in d) || d.about == null || str(d.about, 1500))
        && (!('institution' in d) || d.institution == null || str(d.institution, 120))
        && validUrl(d.get('avatarUrl', null)) && validUrl(d.get('coverImageUrl', null));
    }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function onlyChanges(keys) { return changed().hasOnly(keys); }
    function delta(field) { return request.resource.data[field] - resource.data[field]; }
    function str(v, max) { return v is string && v.size() <= max; }

    // ───────────────────────── admins ─────────────────────────
    match /admins/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isAdmin()
        || (isOwner(uid)
            && request.auth.token.email_verified == true
            && exists(/databases/$(database)/documents/admin_emails/$(request.auth.token.email.lower())));
      allow update, delete: if isAdmin();
    }
    match /admin_emails/{email} {
      allow read, write: if isAdmin();
    }

    // ───────────────────────── users ─────────────────────────
    match /users_private/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isSelf(uid) && request.resource.data.uid == uid;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Verifies a credit movement against its escrow document. `kind` / `id` are marker fields written on the user doc.
    function creditChangeOk() {
      let before = resource.data;
      let after = request.resource.data;
      let kind = after.get('lastCreditKind', '');
      let id = after.get('lastCreditId', '');
      let dC = after.credits - before.credits;
      let dE = after.get('creditsEarned', 0) - before.get('creditsEarned', 0);
      let dM = after.get('teachingMinutes', 0) - before.get('teachingMinutes', 0);
      return after.credits >= 0 && id is string && id.size() > 0 && (
        (kind == 'sos_escrow'      && sosEscrowOk(id, dC, dE, dM, before.credits)) ||
        (kind == 'sos_reward'      && sosRewardOk(id, dC, dE, dM)) ||
        (kind == 'sos_refund'      && sosRefundOk(id, dC, dE, dM)) ||
        (kind == 'session_escrow'  && sessionEscrowOk(id, dC, dE, dM, before.credits)) ||
        (kind == 'session_payout'  && sessionPayoutOk(id, dC, dE, dM)) ||
        (kind == 'session_refund'  && sessionRefundOk(id, dC, dE, dM))
      );
    }
    function sosEscrowOk(id, dC, dE, dM, balance) {
      let p = /databases/$(database)/documents/sos_requests/$(id);
      return !exists(p) && existsAfter(p)
        && getAfter(p).data.requesterId == request.auth.uid
        && getAfter(p).data.status == 'open'
        && balance >= getAfter(p).data.credits
        && dC == -getAfter(p).data.credits && dE == 0 && dM == 0;
    }
    function sosRewardOk(id, dC, dE, dM) {
      let p = /databases/$(database)/documents/sos_requests/$(id);
      return exists(p) && get(p).data.helperId == request.auth.uid
        && get(p).data.status == 'resolved'
        && get(p).data.rewardClaimed == false && getAfter(p).data.rewardClaimed == true
        && dC == get(p).data.credits && dE == get(p).data.credits && dM >= 0 && dM <= 240;
    }
    function sosRefundOk(id, dC, dE, dM) {
      let p = /databases/$(database)/documents/sos_requests/$(id);
      return exists(p) && get(p).data.requesterId == request.auth.uid
        && get(p).data.status == 'cancelled'
        && get(p).data.refundClaimed == false && getAfter(p).data.refundClaimed == true
        && dC == get(p).data.credits && dE == 0 && dM == 0;
    }
    function sessionEscrowOk(id, dC, dE, dM, balance) {
      let p = /databases/$(database)/documents/tutor_sessions/$(id);
      return !exists(p) && existsAfter(p)
        && getAfter(p).data.studentId == request.auth.uid
        && getAfter(p).data.status == 'pending'
        && balance >= getAfter(p).data.credits
        && dC == -getAfter(p).data.credits && dE == 0 && dM == 0;
    }
    function sessionPayoutOk(id, dC, dE, dM) {
      let p = /databases/$(database)/documents/tutor_sessions/$(id);
      return exists(p) && get(p).data.tutorId == request.auth.uid
        && get(p).data.status == 'completed'
        && get(p).data.payoutClaimed == false && getAfter(p).data.payoutClaimed == true
        && dC == get(p).data.credits && dE == get(p).data.credits && dM == get(p).data.durationMin;
    }
    function sessionRefundOk(id, dC, dE, dM) {
      let p = /databases/$(database)/documents/tutor_sessions/$(id);
      return exists(p) && get(p).data.studentId == request.auth.uid
        && get(p).data.status in ['declined', 'cancelled']
        && get(p).data.refundClaimed == false && getAfter(p).data.refundClaimed == true
        && dC == get(p).data.credits && dE == 0 && dM == 0;
    }

    function usernameOwned() {
      return !request.resource.data.keys().hasAny(['usernameLower'])
        || request.resource.data.usernameLower == null
        || getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.usernameLower)).data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if signedIn() || isSelf(uid);

      // New accounts always start as an unprivileged student with the standard starting balance.
      allow create: if isSelf(uid) && notDisposable()
        && profileSane(request.resource.data)
        && request.resource.data.uid == uid
        && request.resource.data.role == 'student'
        && request.resource.data.credits == 100
        && request.resource.data.get('creditsEarned', 0) == 0
        && request.resource.data.get('teachingMinutes', 0) == 0
        && request.resource.data.get('tutorStatus', null) in [null, 'pending']
        && !request.resource.data.keys().hasAny(['universityVerified', 'verifiedUniversityId', 'verifiedUniversityName', 'verifiedAt'])
        && usernameOwned();

      allow update: if isAdmin()
        // during sign-up (before the mailbox is verified) the only allowed change is claiming the username
        || (isSelf(uid) && onlyChanges(['username', 'usernameLower', 'updatedAt']) && usernameOwned())
        || (isOwner(uid)
            && profileSane(request.resource.data)
            && (!resource.data.get('universityVerified', false) || !changed().hasAny(['institution', 'institutionId']))
            && !changed().hasAny(['uid', 'role', 'tutorStatus', 'credentials', 'rates', 'degreeProofName', 'createdAt',
                               'universityVerified', 'verifiedUniversityId', 'verifiedUniversityName', 'verifiedAt'])
            && (!changed().hasAny(['credits', 'creditsEarned', 'teachingMinutes', 'lastCreditKind', 'lastCreditId']) || creditChangeOk())
            && (!changed().hasAny(['username', 'usernameLower']) || usernameOwned()));

      allow delete: if isOwner(uid) || isAdmin();

      // Mutual friendship docs. Each side owns its copy; the recipient may write the sender's copy only while the
      // sender's request to them still exists (i.e. inside the accept batch).
      match /friends/{friendId} {
        allow read: if isOwner(uid);
        allow create: if (isOwner(uid) || (isOwner(friendId)
                          && exists(/databases/$(database)/documents/friend_requests/$('req_' + uid + '_' + friendId))))
                        && request.resource.data.uid == friendId;
        allow update: if isOwner(uid);
        allow delete: if isOwner(uid) || isOwner(friendId);
      }

      match /notifications/{nid} {
        allow read: if isOwner(uid);
        // Anyone signed in may drop a notification in someone's inbox, but only as themselves.
        allow create: if signedIn()
          && request.resource.data.actorId == request.auth.uid
          && request.resource.data.read == false
          && str(request.resource.data.text, 500)
          && (request.resource.data.get('actionUrl', null) == null
              || request.resource.data.actionUrl.matches('^/[A-Za-z0-9/_?=&.%-]{0,200}$'));
        // Owner: mark read / update request status. Author: refresh their own rolling notification (e.g. latest message).
        allow update: if (isOwner(uid) && onlyChanges(['read', 'requestStatus', 'text']))
          || (resource.data.actorId == request.auth.uid
              && request.resource.data.actorId == request.auth.uid
              && request.resource.data.read == false);
        allow delete: if isOwner(uid) || resource.data.actorId == request.auth.uid;
      }

      // Peer reviews: only my study buddies can write one about me; the reviewer id is the doc id.
      match /reviews/{rid} {
        allow read: if signedIn();
        allow create, update: if isOwner(rid) && rid != uid
          && request.resource.data.reviewerId == rid
          && exists(/databases/$(database)/documents/users/$(rid)/friends/$(uid))
          && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
          && str(request.resource.data.text, 500);
        allow delete: if isOwner(rid) || isOwner(uid);
      }

      match /creditHistory/{hid} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid);
        allow delete: if isOwner(uid);   // only used when deleting the whole account
      }

      // Plain per-user data: only the owner can touch it.
      match /{coll}/{docId} {
        allow read, write: if isOwner(uid)
          && coll in ['achievements', 'bookmarks', 'sosBookmarks', 'sosOffers', 'groups',
                      'quizzes', 'roadmaps', 'quizProgress', 'roadmapProgress', 'studyDays'];
      }
    }

    // ───────────────────────── usernames ─────────────────────────
    match /usernames/{handle} {
      allow get: if true;             // needed for the sign-up form's live availability check
      allow list: if signedIn();
      allow create: if authed()
        && request.resource.data.uid == request.auth.uid
        && handle.matches('^[a-z0-9_]{3,20}$')
        && !reservedHandle(handle)
        && request.resource.data.username == handle;
      allow update, delete: if authed() && resource.data.uid == request.auth.uid;
    }

    // ───────────────────────── buddies ─────────────────────────
    match /friend_requests/{rid} {
      allow read: if signedIn() && (resource == null || resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isOwner(request.resource.data.fromUid)
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && rid == 'req_' + request.resource.data.fromUid + '_' + request.resource.data.toUid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(request.resource.data.toUid));
      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    // ───────────────────────── messaging ─────────────────────────
    function convUpdateKeysOk() {
      return changed().hasOnly(['lastMessage', 'lastMessageAt', 'unread', 'lastRead', 'typing', 'status',
                                'participants', 'participantInfo']);
    }
    function participantsDiffIsMe() {
      let a = request.resource.data.participants.toSet();
      let b = resource.data.participants.toSet();
      return a.difference(b).union(b.difference(a)).hasOnly([request.auth.uid]);
    }
    function convStatusOk() {
      return request.resource.data.status == resource.data.status
        || (resource.data.status == 'pending'
            && resource.data.get('requestedBy', '') != request.auth.uid
            && request.resource.data.status in ['accepted', 'declined']);
    }

    match /conversations/{cid} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.participants);

      allow create: if signedIn() && request.auth.uid in request.resource.data.participants
        && (
          // 1:1 chat: deterministic id, buddies start accepted, everyone else starts a pending request
          (request.resource.data.type == 'direct'
            && request.resource.data.participants.size() == 2
            && cid == request.resource.data.participants[0] + '_' + request.resource.data.participants[1]
            && (
              (request.resource.data.status == 'accepted'
                && exists(/databases/$(database)/documents/users/$(request.auth.uid)/friends/$(request.resource.data.participants.removeAll([request.auth.uid])[0])))
              ||
              (request.resource.data.status == 'pending' && request.resource.data.requestedBy == request.auth.uid)
            ))
          ||
          // group chat: created in the same batch as its group, by the group's owner
          (request.resource.data.type == 'group'
            && cid == 'group_' + request.resource.data.groupId
            && existsAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
            && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.auth.uid)
        );

      allow update: if signedIn() && convUpdateKeysOk() && (
        // existing participant: send / read / type / (direct) respond to a request / (group) leave
        (request.auth.uid in resource.data.participants
          && convStatusOk()
          && (request.resource.data.participants == resource.data.participants
              || (resource.data.type == 'group' && participantsDiffIsMe()
                  && !existsAfter(/databases/$(database)/documents/groups/$(resource.data.groupId)/members/$(request.auth.uid)))))
        ||
        // joining a group chat: only if the membership doc is created in the same batch
        (resource.data.type == 'group' && participantsDiffIsMe()
          && existsAfter(/databases/$(database)/documents/groups/$(resource.data.groupId)/members/$(request.auth.uid)))
      );

      allow delete: if signedIn() && resource.data.type == 'group'
        && get(/databases/$(database)/documents/groups/$(resource.data.groupId)).data.ownerId == request.auth.uid;

      match /messages/{mid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants;
        allow create: if signedIn()
          && request.resource.data.senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(cid)).data.participants
          && get(/databases/$(database)/documents/conversations/$(cid)).data.status != 'declined'
          && str(request.resource.data.text, 4000)
          && request.resource.data.get('attachments', []).size() <= 5
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;   // messages are immutable
      }
    }

    // ───────────────────────── community ─────────────────────────
    match /posts/{pid} {
      allow read: if signedIn();
      allow create: if isOwner(request.resource.data.authorId)
        && request.resource.data.author.uid == request.auth.uid
        && (request.resource.data.author.get('verified', false) == false
            || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('universityVerified', false) == true)
        && str(request.resource.data.title, 200) && request.resource.data.title.size() > 0
        && str(request.resource.data.body, 5000)
        && request.resource.data.likesCount == 0
        && request.resource.data.commentsCount == 0
        && request.resource.data.reportCount == 0
        && request.resource.data.get('imageUrls', []).size() <= 4
        && request.resource.data.createdAt == request.time;

      allow update: if isAdmin()
        // author edits their own content
        || (isOwner(resource.data.authorId) && onlyChanges(['title', 'body', 'subject', 'tag', 'keywords']))
        // like / unlike: counter moves by exactly 1 together with the like document
        || (signedIn() && onlyChanges(['likesCount']) && (
              (delta('likesCount') == 1
                && existsAfter(/databases/$(database)/documents/posts/$(pid)/likes/$(request.auth.uid))
                && !exists(/databases/$(database)/documents/posts/$(pid)/likes/$(request.auth.uid)))
              ||
              (delta('likesCount') == -1
                && !existsAfter(/databases/$(database)/documents/posts/$(pid)/likes/$(request.auth.uid))
                && exists(/databases/$(database)/documents/posts/$(pid)/likes/$(request.auth.uid)))
           ))
        // comment counter (verified from the comment side too)
        || (signedIn() && onlyChanges(['commentsCount']) && (delta('commentsCount') == 1 || delta('commentsCount') == -1))
        // report: one per user, enforced by the deterministic report id
        || (signedIn() && onlyChanges(['reportCount']) && delta('reportCount') == 1
            && existsAfter(/databases/$(database)/documents/reports/$(pid + '_' + request.auth.uid))
            && !exists(/databases/$(database)/documents/reports/$(pid + '_' + request.auth.uid)));

      allow delete: if isOwner(resource.data.authorId) || isAdmin();

      match /likes/{uid} {
        allow read: if signedIn();
        allow create: if isOwner(uid) && request.resource.data.uid == uid;
        allow delete: if isOwner(uid) || isAdmin() || isOwner(get(/databases/$(database)/documents/posts/$(pid)).data.authorId);
      }

      match /comments/{cid} {
        allow read: if signedIn();
        allow create: if isOwner(request.resource.data.authorId)
          && str(request.resource.data.body, 2000) && request.resource.data.body.size() > 0
          && getAfter(/databases/$(database)/documents/posts/$(pid)).data.commentsCount
             == get(/databases/$(database)/documents/posts/$(pid)).data.commentsCount + 1;
        allow delete: if isOwner(resource.data.authorId)
          || isOwner(get(/databases/$(database)/documents/posts/$(pid)).data.authorId)
          || isAdmin();
      }
    }

    match /reports/{rid} {
      allow read: if isAdmin() || (signedIn() && (resource == null || resource.data.reporterId == request.auth.uid));
      allow create: if isOwner(request.resource.data.reporterId)
        && rid == request.resource.data.postId + '_' + request.auth.uid
        && request.resource.data.status == 'open';
      allow update, delete: if isAdmin();
    }

    // ───────────────────────── SOS ─────────────────────────
    function userCredits(uid) { return get(/databases/$(database)/documents/users/$(uid)).data.credits; }
    function userCreditsAfter(uid) { return getAfter(/databases/$(database)/documents/users/$(uid)).data.credits; }
    function userMarkerAfter(uid) { return getAfter(/databases/$(database)/documents/users/$(uid)).data; }

    match /sos_requests/{sid} {
      allow read: if signedIn();

      allow create: if isOwner(request.resource.data.requesterId)
        && request.resource.data.requester.uid == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.offersCount == 0
        && request.resource.data.helperId == null
        && request.resource.data.escrowed == true
        && request.resource.data.rewardClaimed == false
        && request.resource.data.refundClaimed == false
        && request.resource.data.credits is int
        && request.resource.data.credits >= 10 && request.resource.data.credits <= 1000
        && str(request.resource.data.title, 200) && request.resource.data.title.size() > 0
        // the escrow must be taken from the requester in the same batch
        && userCreditsAfter(request.auth.uid) == userCredits(request.auth.uid) - request.resource.data.credits
        && userMarkerAfter(request.auth.uid).lastCreditKind == 'sos_escrow'
        && userMarkerAfter(request.auth.uid).lastCreditId == sid;

      allow update: if isAdmin()
        // requester accepts a helper who has actually offered
        || (isOwner(resource.data.requesterId) && resource.data.status == 'open'
            && onlyChanges(['status', 'helperId', 'helper', 'acceptedAt'])
            && request.resource.data.status == 'in_progress'
            && request.resource.data.helperId != request.auth.uid
            && request.resource.data.helper.uid == request.resource.data.helperId
            && exists(/databases/$(database)/documents/sos_requests/$(sid)/offers/$(request.resource.data.helperId)))
        // requester resolves
        || (isOwner(resource.data.requesterId) && resource.data.status == 'in_progress'
            && onlyChanges(['status', 'closedAt']) && request.resource.data.status == 'resolved')
        // requester cancels (escrow is then refunded via the refund claim below)
        || (isOwner(resource.data.requesterId) && resource.data.status in ['open', 'in_progress']
            && onlyChanges(['status', 'closedAt']) && request.resource.data.status == 'cancelled')
        // requester claims the refund; user balance must rise by exactly the escrow in the same batch
        || (isOwner(resource.data.requesterId) && resource.data.status == 'cancelled'
            && resource.data.refundClaimed == false && onlyChanges(['refundClaimed'])
            && request.resource.data.refundClaimed == true
            && userCreditsAfter(request.auth.uid) == userCredits(request.auth.uid) + resource.data.credits
            && userMarkerAfter(request.auth.uid).lastCreditKind == 'sos_refund'
            && userMarkerAfter(request.auth.uid).lastCreditId == sid)
        // helper claims the reward after the requester resolved
        || (resource.data.helperId == request.auth.uid && resource.data.status == 'resolved'
            && resource.data.rewardClaimed == false && onlyChanges(['rewardClaimed'])
            && request.resource.data.rewardClaimed == true
            && userCreditsAfter(request.auth.uid) == userCredits(request.auth.uid) + resource.data.credits
            && userMarkerAfter(request.auth.uid).lastCreditKind == 'sos_reward'
            && userMarkerAfter(request.auth.uid).lastCreditId == sid)
        // a new offer bumps the counter together with the offer document
        || (signedIn() && resource.data.status == 'open' && resource.data.requesterId != request.auth.uid
            && onlyChanges(['offersCount']) && delta('offersCount') == 1
            && existsAfter(/databases/$(database)/documents/sos_requests/$(sid)/offers/$(request.auth.uid))
            && !exists(/databases/$(database)/documents/sos_requests/$(sid)/offers/$(request.auth.uid)));

      match /offers/{hid} {
        allow read: if signedIn() && (resource == null || resource.data.helperId == request.auth.uid
                    || get(/databases/$(database)/documents/sos_requests/$(sid)).data.requesterId == request.auth.uid);
        allow create: if isOwner(hid) && request.resource.data.helperId == hid
          && get(/databases/$(database)/documents/sos_requests/$(sid)).data.status == 'open'
          && get(/databases/$(database)/documents/sos_requests/$(sid)).data.requesterId != hid
          && str(request.resource.data.note, 500);
        allow delete: if isOwner(hid);
      }
    }

    // ───────────────────────── tutors ─────────────────────────
    match /tutor_applications/{aid} {
      allow read: if isOwner(aid) || isAdmin();
      allow create: if isSelf(aid) && notDisposable() && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending'
        && str(request.resource.data.get('bio', ''), 1500) && str(request.resource.data.get('credentials', ''), 300);
      allow update, delete: if isAdmin();
    }

    match /tutor_profiles/{tid} {
      allow read: if signedIn();
      allow create: if isAdmin()
        || (isOwner(tid) && get(/databases/$(database)/documents/users/$(tid)).data.role == 'tutor'
            && request.resource.data.ratingSum == 0 && request.resource.data.ratingCount == 0
            && request.resource.data.sessionsCompleted == 0);
      allow update: if isAdmin()
        || (isOwner(tid) && !changed().hasAny(['ratingSum', 'ratingCount', 'sessionsCompleted', 'lastRatedSession', 'uid']))
        // a student rating a delivered session: aggregates move by exactly this session's rating
        || (signedIn() && onlyChanges(['ratingSum', 'ratingCount', 'sessionsCompleted', 'lastRatedSession'])
            && get(/databases/$(database)/documents/tutor_sessions/$(request.resource.data.lastRatedSession)).data.studentId == request.auth.uid
            && get(/databases/$(database)/documents/tutor_sessions/$(request.resource.data.lastRatedSession)).data.tutorId == tid
            && get(/databases/$(database)/documents/tutor_sessions/$(request.resource.data.lastRatedSession)).data.status == 'delivered'
            && getAfter(/databases/$(database)/documents/tutor_sessions/$(request.resource.data.lastRatedSession)).data.status == 'completed'
            && delta('ratingCount') == 1 && delta('sessionsCompleted') == 1
            && delta('ratingSum') == getAfter(/databases/$(database)/documents/tutor_sessions/$(request.resource.data.lastRatedSession)).data.rating);
      allow delete: if isAdmin();
    }

    match /tutor_sessions/{sid} {
      allow read: if signedIn() && (resource == null || resource.data.studentId == request.auth.uid
                  || resource.data.tutorId == request.auth.uid || isAdmin());

      allow create: if isOwner(request.resource.data.studentId)
        && request.resource.data.tutorId != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.escrowed == true
        && request.resource.data.payoutClaimed == false
        && request.resource.data.refundClaimed == false
        && get(/databases/$(database)/documents/tutor_profiles/$(request.resource.data.tutorId)).data.acceptingSessions == true
        // price must equal the tutor's published rate for that mode
        && get(/databases/$(database)/documents/tutor_profiles/$(request.resource.data.tutorId)).data.rates[request.resource.data.mode] == request.resource.data.credits
        && userCreditsAfter(request.auth.uid) == userCredits(request.auth.uid) - request.resource.data.credits
        && userMarkerAfter(request.auth.uid).lastCreditKind == 'session_escrow'
        && userMarkerAfter(request.auth.uid).lastCreditId == sid;

      allow update: if isAdmin()
        // tutor
        || (isOwner(resource.data.tutorId) && resource.data.status == 'pending'
            && onlyChanges(['status', 'acceptedAt']) && request.resource.data.status == 'accepted')
        || (isOwner(resource.data.tutorId) && resource.data.status == 'pending'
            && onlyChanges(['status']) && request.resource.data.status == 'declined')
        || (isOwner(resource.data.tutorId) && resource.data.status == 'accepted'
            && onlyChanges(['status', 'deliveredAt']) && request.resource.data.status == 'delivered')
        || (isOwner(resource.data.tutorId) && resource.data.status == 'delivered'
            && request.time > resource.data.deliveredAt + duration.value(72, 'h')
            && onlyChanges(['status', 'completedAt']) && request.resource.data.status == 'completed')
        || (isOwner(resource.data.tutorId) && resource.data.status == 'completed'
            && resource.data.payoutClaimed == false && onlyChanges(['payoutClaimed'])
            && request.resource.data.payoutClaimed == true
            && userCreditsAfter(request.auth.uid) == userCredits(request.auth.uid) + resource.data.credits
            && userMarkerAfter(request.auth.uid).lastCreditKind == 'session_payout'
            && userMarkerAfter(request.auth.uid).lastCreditId == sid)
        // student
        || (isOwner(resource.data.studentId) && resource.data.status in ['pending', 'accepted']
            && onlyChanges(['status']) && request.resource.data.status == 'cancelled')
        || (isOwner(resource.data.studentId) && resource.data.status == 'delivered'
            && onlyChanges(['status', 'completedAt', 'rating', 'review']) && request.resource.data.status == 'completed'
            && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
            && getAfter(/databases/$(database)/documents/tutor_profiles/$(resource.data.tutorId)).data.lastRatedSession == sid)
        || (isOwner(resource.data.studentId) && resource.data.status in ['declined', 'cancelled']
            && resource.data.refundClaimed == false && onlyChanges(['refundClaimed'])
            && request.resource.data.refundClaimed == true
            && userCreditsAfter(request.auth.uid) == userCredits(request.auth.uid) + resource.data.credits
            && userMarkerAfter(request.auth.uid).lastCreditKind == 'session_refund'
            && userMarkerAfter(request.auth.uid).lastCreditId == sid);
    }

    // ───────────────────────── groups ─────────────────────────
    function isGroupMember(gid, uid) { return exists(/databases/$(database)/documents/groups/$(gid)/members/$(uid)); }

    match /groups/{gid} {
      allow read: if signedIn() && (resource == null || resource.data.privacy == 'public' || isGroupMember(gid, request.auth.uid));
      allow create: if isOwner(request.resource.data.ownerId)
        && request.resource.data.memberCount == 1
        && str(request.resource.data.name, 80) && request.resource.data.name.size() > 0
        && request.resource.data.privacy in ['public', 'private']
        && existsAfter(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid));
      allow update: if isAdmin()
        || (isOwner(resource.data.ownerId) && onlyChanges(['name', 'description', 'schedule', 'subject', 'privacy', 'color', 'searchTokens']))
        // join / leave: counter moves by one together with the member document
        || (signedIn() && onlyChanges(['memberCount']) && (
              (delta('memberCount') == 1
                && existsAfter(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid))
                && !isGroupMember(gid, request.auth.uid))
              ||
              (delta('memberCount') == -1
                && !existsAfter(/databases/$(database)/documents/groups/$(gid)/members/$(request.auth.uid))
                && isGroupMember(gid, request.auth.uid))
           ))
        || (signedIn() && onlyChanges(['lastActivityAt']) && isGroupMember(gid, request.auth.uid));
      allow delete: if isOwner(resource.data.ownerId) || isAdmin();

      match /members/{uid} {
        allow read: if signedIn() && (isGroupMember(gid, request.auth.uid)
                    || get(/databases/$(database)/documents/groups/$(gid)).data.privacy == 'public');
        allow create: if
          // owner row, created together with the group
          (isOwner(uid) && request.resource.data.role == 'owner'
            && existsAfter(/databases/$(database)/documents/groups/$(gid))
            && getAfter(/databases/$(database)/documents/groups/$(gid)).data.ownerId == uid
            && !exists(/databases/$(database)/documents/groups/$(gid)))
          ||
          // everyone else: public groups are open, private groups need an invitation addressed to them
          (isOwner(uid) && request.resource.data.role == 'member'
            && exists(/databases/$(database)/documents/groups/$(gid))
            && (get(/databases/$(database)/documents/groups/$(gid)).data.privacy == 'public'
                || exists(/databases/$(database)/documents/group_invites/$(gid + '_' + uid))));
        allow delete: if isOwner(uid)
          || isOwner(get(/databases/$(database)/documents/groups/$(gid)).data.ownerId)
          || isAdmin();
      }
    }

    match /group_invites/{iid} {
      allow read: if signedIn() && (resource == null || resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
      allow create: if isOwner(request.resource.data.fromUid)
        && iid == request.resource.data.groupId + '_' + request.resource.data.toUid
        && getAfter(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.ownerId == request.auth.uid;
      allow delete: if signedIn() && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    // ───────────────────────── learning content ─────────────────────────
    match /universities/{uid2} { allow read: if signedIn(); allow write: if isAdmin(); }
    match /quizzes/{qid}   { allow read: if signedIn(); allow write: if isAdmin(); }
    match /roadmaps/{rid}  { allow read: if signedIn(); allow write: if isAdmin(); }

    // ───────────────────────── everything else ─────────────────────────
    match /{document=**} { allow read, write: if false; }
  }
}
